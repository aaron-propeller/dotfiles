{{- if eq .user_data.machine_type "work" -}}
#!/bin/zsh
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

export NVM_DIR="$HOME/.nvm"
. "$NVM_DIR/nvm.sh"

# Preflight: skip cleanly if 1Password CLI isn't signed in yet.
#
# On a fresh install the LaunchAgent's first RunAtLoad fires before the user
# has had a chance to enable 1Password app + CLI integration (or run
# `op signin`). Failing loudly here left the log full of scary auth errors and
# no npm token set. Skipping is fine — the agent re-fires daily at 09:00 and
# once signin is set up the next fire succeeds.
if ! op whoami >/dev/null 2>&1; then
  echo "$(date -u +%FT%TZ) npm-token-refresh: 1Password CLI not signed in; skipping."
  echo "  Enable 1Password app -> Settings -> Developer -> 'Integrate with 1Password CLI',"
  echo "  or run 'op signin', then this LaunchAgent will pick up the token on next fire."
  exit 0
fi

TOKEN=$(op read 'op://General Propeller Shared/xwneoyzl3dju77445bvu6mftc4/password')
npm config set //registry.npmjs.org/:_authToken "$TOKEN"
echo "$(date -u +%FT%TZ) npm-token-refresh: token refreshed."

# With the token now in ~/.npmrc, ensure the Propeller CLI is installed. Only
# run on the first successful refresh (once prp is on PATH, this no-ops). This
# is here rather than in install-dependencies because that script fires on
# initial bootstrap, long before 1Password CLI signin is set up.
if ! command -v prp >/dev/null 2>&1; then
  export PNPM_HOME="$HOME/Library/pnpm"
  export PATH="$PNPM_HOME:$PATH"
  mkdir -p "$PNPM_HOME"
  echo "$(date -u +%FT%TZ) npm-token-refresh: installing @propelleraero/prp..."
  pnpm add -g @propelleraero/prp
fi
{{- end }}
