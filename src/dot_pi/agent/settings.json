{
  "shellPath": "/bin/zsh",
  "shellCommandPrefix": "source ~/.zshrc",
  "lastChangelogVersion": "0.80.2",
  "enableSkillCommands": false,
  "defaultProvider": "amazon-bedrock",
  "defaultModel": "global.anthropic.claude-opus-4-8",
  "defaultThinkingLevel": "xhigh",
  "packages": [
    "~/src/pi-packages/packages/pippin",
    "~/src/pi-packages/packages/pi-cockpit",
    "~/src/pi-packages/packages/pi-personas",
    "~/src/pi-packages/packages/themes",
    "~/src/pi-packages/packages/pi-plan",
    "~/src/pi-packages/packages/pi-bedrock-mantle",
    "npm:pi-mcp-adapter",
    "../../src/pi-packages/packages/pi-packages-requests",
    "npm:@pi-stef/figma"
  ],
  "theme": "nordic",
  "pippin": {
    "specs": [
      {
        "path": "~/src/pi-packages/packages/pi-cockpit"
      },
      {
        "path": "~/src/pi-packages/packages/themes"
      },
      {
        "path": "~/src/pi-packages/packages/pippin"
      }
    ]
  },
  "hideThinkingBlock": true
}