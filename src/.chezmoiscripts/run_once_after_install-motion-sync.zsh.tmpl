#! /bin/zsh
{{- if eq .user_data.machine_type "work" }}

# Pulls the motion-sync repo and installs its macOS LaunchAgent (the "cron")
# that syncs Motion <-> Jira every 15 minutes. See:
#   https://github.com/aaron-propeller/motion-sync
#
# Prerequisites (handled by run_once_after_install-dependencies.zsh.tmpl):
#   - git, nvm + node, npm
# Prerequisites (handled by you, manually, per README.md):
#   - An SSH key uploaded to GitHub
#   - A populated ~/src/motion-sync/.env (see .env.example)

set -e

REPO_URL="git@github.com:aaron-propeller/motion-sync.git"
REPO_DIR="{{ .chezmoi.homeDir }}/src/motion-sync"

echo "Setting up motion-sync..."

# Make sure nvm-managed node is on PATH — LaunchAgents can't find it otherwise.
export NVM_DIR="{{ .chezmoi.homeDir }}/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck disable=SC1091
  source "$NVM_DIR/nvm.sh"
fi

mkdir -p "$(dirname "$REPO_DIR")"

if [[ -d "$REPO_DIR/.git" ]]; then
  echo "  motion-sync repo already exists, pulling latest..."
  git -C "$REPO_DIR" pull --ff-only
else
  echo "  cloning motion-sync into $REPO_DIR..."
  git clone "$REPO_URL" "$REPO_DIR"
fi

echo "  installing npm dependencies..."
(cd "$REPO_DIR" && npm install)

if [[ ! -f "$REPO_DIR/.env" ]]; then
  cat <<WARN

  !! Skipping LaunchAgent install: $REPO_DIR/.env not found.
     Copy .env.example to .env, fill in the Motion/Jira credentials, then run:
       $REPO_DIR/scripts/install-daemon.sh

WARN
  exit 0
fi

echo "  installing motion-sync LaunchAgent (runs every 15 min)..."
"$REPO_DIR/scripts/install-daemon.sh"
{{- end }}
