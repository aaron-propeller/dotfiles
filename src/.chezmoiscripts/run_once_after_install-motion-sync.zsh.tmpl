#! /bin/zsh
{{- if ne .user_data.profile "workspace" -}}
{{- if eq .user_data.profile "work" }}

# Pulls the motion-sync repo and installs its macOS LaunchAgent (the "cron")
# that syncs Motion <-> Jira every 15 minutes. See:
#   https://github.com/aaron-propeller/motion-sync
#
# Prerequisites (handled by run_once_after_install-dependencies.zsh.tmpl):
#   - git, nvm + node, npm
# Prerequisites (handled by you, manually, per README.md):
#   - An SSH key uploaded to GitHub
#   - A populated ~/src/motion-sync/.env (see .env.example)

set -e

REPO_URL="git@github.com:aaron-propeller/motion-sync.git"
REPO_DIR="{{ .chezmoi.homeDir }}/src/motion-sync"

echo "Setting up motion-sync..."

# Preflight: SSH to GitHub must work, otherwise the clone below hangs on a
# password prompt or fails with "Permission denied (publickey)". The README
# lists uploading an SSH key as a manual post-bootstrap step, so on a first
# install we may hit this before the user has done that. Skip cleanly and tell
# them how to resume.
if ! ssh -T -o BatchMode=yes -o StrictHostKeyChecking=accept-new git@github.com 2>&1 \
    | grep -qE "successfully authenticated|You've successfully authenticated"; then
  cat <<EOM

  !! Skipping motion-sync: SSH auth to github.com is not set up.
     Generate an SSH key, add it to https://github.com/settings/keys, then run:
       chezmoi state delete-bucket --bucket=scriptState && chezmoi apply

EOM
  exit 0
fi

# Make sure nvm-managed node is on PATH — LaunchAgents can't find it otherwise.
export NVM_DIR="{{ .chezmoi.homeDir }}/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck disable=SC1091
  source "$NVM_DIR/nvm.sh"
fi

mkdir -p "$(dirname "$REPO_DIR")"

if [[ -d "$REPO_DIR/.git" ]]; then
  echo "  motion-sync repo already exists, pulling latest..."
  # Fetch first so we have current remote refs. Only try to fast-forward if the
  # branch has an upstream configured — a detached or upstream-less local branch
  # otherwise errors out with 'no tracking information'.
  git -C "$REPO_DIR" fetch --quiet origin || true
  if git -C "$REPO_DIR" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    git -C "$REPO_DIR" pull --ff-only --quiet || echo "  (fast-forward failed; leaving as-is)"
  else
    echo "  (no upstream tracking on current branch; skipping pull)"
  fi
else
  echo "  cloning motion-sync into $REPO_DIR..."
  git clone "$REPO_URL" "$REPO_DIR"
fi

echo "  installing npm dependencies..."
(cd "$REPO_DIR" && npm install)

if [[ ! -f "$REPO_DIR/.env" ]]; then
  cat <<WARN

  !! Skipping LaunchAgent install: $REPO_DIR/.env not found.
     Copy .env.example to .env, fill in the Motion/Jira credentials, then run:
       $REPO_DIR/scripts/install-daemon.sh

WARN
  exit 0
fi

echo "  installing motion-sync LaunchAgent (runs every 15 min)..."
"$REPO_DIR/scripts/install-daemon.sh"
{{- end }}
{{- else -}}
echo "[chezmoi] skipping {{ base .chezmoi.sourceFile }} — this is a Coder workspace"
{{- end }}
