#! /bin/zsh
# Clones aaron-propeller/pi-packages and runs npm install in each sub-package.
# HTTPS clone on workspaces (uses gh's credential helper), SSH clone elsewhere.
set -e

REPO_DIR="{{ .chezmoi.homeDir }}/src/pi-packages"
{{- if eq .user_data.profile "workspace" }}
REPO_URL="https://github.com/aaron-propeller/pi-packages.git"
{{- else }}
REPO_URL="git@github.com:aaron-propeller/pi-packages.git"
{{- end }}

echo "Setting up pi-packages (url=$REPO_URL)..."

{{- if eq .user_data.profile "workspace" }}
if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
  echo "  skipping: gh not authenticated. Rerun with 'chezmoi state delete-bucket --bucket=scriptState && chezmoi apply'."
  exit 0
fi
gh auth setup-git 2>/dev/null || true
{{- else }}
if ! ssh -T -o BatchMode=yes -o StrictHostKeyChecking=accept-new git@github.com 2>&1 \
    | grep -qE "successfully authenticated|You've successfully authenticated"; then
  echo "  skipping: no SSH auth to github.com. Add an SSH key at https://github.com/settings/keys then rerun with 'chezmoi state delete-bucket --bucket=scriptState && chezmoi apply'."
  exit 0
fi
{{- end }}

export NVM_DIR="{{ .chezmoi.homeDir }}/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck disable=SC1091
  source "$NVM_DIR/nvm.sh"
fi

mkdir -p "$(dirname "$REPO_DIR")"

if [[ -d "$REPO_DIR/.git" ]]; then
  git -C "$REPO_DIR" fetch --quiet origin || true
  if git -C "$REPO_DIR" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    git -C "$REPO_DIR" pull --ff-only --quiet || echo "  (fast-forward failed)"
  fi
else
  git clone "$REPO_URL" "$REPO_DIR"
fi

for pkg in "$REPO_DIR"/packages/*/; do
  if [[ -f "$pkg/package.json" ]]; then
    echo "  npm install: $(basename "$pkg")"
    (cd "$pkg" && npm install --silent)
  fi
done
