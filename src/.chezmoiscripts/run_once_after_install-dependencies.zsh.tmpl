#! /bin/zsh

echo "Installing Xcode command line tools..."
xcode-select --install

# Install Homebrew along with formulae and casks

echo "Installing brew..."
{{- if .user_data.run_as_admin }}
# Configure brew to download and install necessary applications
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# Load brew into the current shell so subsequent `brew` / `pnpm` / `gh` / etc.
# calls resolve. On a fresh machine ~/.zshrc doesn't put /opt/homebrew/bin on
# PATH until path.zsh runs, and sourcing .zshrc mid-install is fragile because
# antidote/prompt setup can error out before reaching path.zsh.
eval "$(/opt/homebrew/bin/brew shellenv)"

brew update
brew doctor

echo "Installing cli tools..."
# Install CLI apps
brew install chezmoi
brew install neovim
brew install crystal
brew install direnv
brew install tree
brew install the_silver_searcher
brew install saulpw/vd/visidata
brew install gh
brew install git-crypt
brew install pnpm
brew install pyenv
brew install terminal-notifier
{{- if eq .user_data.machine_type "personal" }}
# Personal clis
{{- end }}
{{- if eq .user_data.machine_type "work" }}
# Work clis
brew install awscli
brew install tfenv
brew install derailed/k9s/k9s
{{- end }}

echo "Installing casks..."
# Install Cask apps
brew install --cask 1password
brew install --cask slack
brew install --cask firefox
brew install --cask spotify
brew install --cask ghostty
brew install --cask docker
brew install --cask finicky
{{- if eq .user_data.machine_type "personal" }}
# Personal casks
brew install --cask discord
brew install --cask mullvadvpn
brew install --cask steam
brew install --cask vlc
brew install --cask openemu
{{- end }}
{{- if eq .user_data.machine_type "work" }}
# Work casks
brew install --cask visual-studio-code
brew install --cask google-chrome
brew install --cask 1password-cli
brew install --cask freelens
brew install --cask cmux
brew install --cask cmux-nightly
brew install --cask motion
brew install --cask notion-calendar
brew install --cask tailscale
{{- end }}
{{- end }}

# --------------------------------------------------------

echo "Installing antidote for shell plugins..."

# Install antidote to enable shell plugins
git clone --depth=1 https://github.com/mattmc3/antidote.git ~/.zsh/.antidote

# --------------------------------------------------------

echo "Installing nvm to manage node versions..."

# Clone nvm and install the latest version of node
git clone https://github.com/nvm-sh/nvm.git ~/.nvm

# Go into the nvm repo in a subshell and checkout the latest release
(cd ~/.nvm && git checkout v0.39.5)

# Source the shell so we can install node using nvm
source ~/.zshrc

# Also load nvm directly — sourcing .zshrc can bail before reaching the nvm
# init line if any earlier plugin/prompt file errors on a fresh install.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# Install latest node version
nvm install node

# --------------------------------------------------------

echo "Installing shared node packages..."

# Install some packages globally that are needed by nvim plugins
npm install -g typescript-language-server
npm install -g jjson
pnpm add -g --ignore-scripts @earendil-works/pi-coding-agent
{{- if eq .user_data.machine_type "work" }}
pnpm add -g @propelleraero/prp
{{- end }}

