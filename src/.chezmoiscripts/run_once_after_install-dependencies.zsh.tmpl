#! /bin/zsh
{{- if not .user_data.is_workspace -}}

# Arch guard: on Apple Silicon, refuse to run under Rosetta 2. Homebrew's
# arm64 prefix (/opt/homebrew) rejects x86_64 cask installs with
#   Error: Cannot install under Rosetta 2 in ARM default prefix
# Rather than let 10+ casks fail one by one, bail early with instructions.
if [[ "$(sysctl -n hw.optional.arm64 2>/dev/null)" == "1" && "$(uname -m)" == "x86_64" ]]; then
  cat >&2 <<'ROSETTA_ERR'
error: this shell is running under Rosetta 2 (x86_64) on an arm64 Mac.
       Homebrew casks will not install into /opt/homebrew from a Rosetta
       shell. Quit this terminal, uncheck 'Open using Rosetta' in the
       terminal app's Get Info panel, re-open, verify with 'uname -m'
       (should print arm64), then re-run:
         chezmoi state delete-bucket --bucket=scriptState && chezmoi apply
ROSETTA_ERR
  exit 1
fi

echo "Installing Xcode command line tools..."
xcode-select --install

# Install Homebrew along with formulae and casks

echo "Installing brew..."
{{- if .user_data.run_as_admin }}
# Configure brew to download and install necessary applications
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# Load brew into the current shell so subsequent `brew` / `pnpm` / `gh` / etc.
# calls resolve. On a fresh machine ~/.zshrc doesn't put /opt/homebrew/bin on
# PATH until path.zsh runs, and sourcing .zshrc mid-install is fragile because
# antidote/prompt setup can error out before reaching path.zsh.
eval "$(/opt/homebrew/bin/brew shellenv)"

brew update
brew doctor

echo "Installing cli tools..."
# Install CLI apps
brew install chezmoi
brew install neovim
brew install crystal
brew install direnv
brew install tree
brew install the_silver_searcher
brew install saulpw/vd/visidata
brew install gh
brew install git-crypt
brew install pnpm
brew install pyenv
brew install terminal-notifier
{{- if eq .user_data.machine_type "personal" }}
# Personal clis
{{- end }}
{{- if eq .user_data.machine_type "work" }}
# Work clis
brew install awscli
brew install tfenv
brew install derailed/k9s/k9s
{{- end }}

echo "Installing casks..."
# Install Cask apps
brew install --cask 1password
brew install --cask slack
brew install --cask firefox
brew install --cask spotify
brew install --cask ghostty
brew install --cask docker
brew install --cask finicky
{{- if eq .user_data.machine_type "personal" }}
# Personal casks
brew install --cask discord
brew install --cask mullvadvpn
brew install --cask steam
brew install --cask vlc
brew install --cask openemu
{{- end }}
{{- if eq .user_data.machine_type "work" }}
# Work casks
brew install --cask visual-studio-code
brew install --cask google-chrome
brew install --cask 1password-cli
brew install --cask freelens
brew install --cask cmux
brew install --cask motion
brew install --cask notion-calendar
brew install --cask tailscale-app
{{- end }}
{{- end }}

# --------------------------------------------------------

echo "Installing antidote for shell plugins..."

# Install antidote to enable shell plugins (idempotent — safe on re-runs).
if [[ ! -d "$HOME/.zsh/.antidote/.git" ]]; then
  git clone --depth=1 https://github.com/mattmc3/antidote.git ~/.zsh/.antidote
fi

# --------------------------------------------------------

echo "Installing nvm to manage node versions..."

# Clone nvm and install the latest version of node (idempotent).
if [[ ! -d "$HOME/.nvm/.git" ]]; then
  git clone https://github.com/nvm-sh/nvm.git ~/.nvm
  (cd ~/.nvm && git checkout v0.39.5)
fi

# Source the shell so we can install node using nvm
source ~/.zshrc

# Also load nvm directly — sourcing .zshrc can bail before reaching the nvm
# init line if any earlier plugin/prompt file errors on a fresh install.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# Install latest node version
nvm install node

# --------------------------------------------------------

echo "Installing shared node packages..."

# pnpm refuses to install globals unless its global bin dir is on PATH. Its
# default on macOS is ~/Library/pnpm. Set it up here for this script run;
# path.zsh persists the same values for interactive shells.
export PNPM_HOME="$HOME/Library/pnpm"
mkdir -p "$PNPM_HOME"
export PATH="$PNPM_HOME:$PATH"

# Install some packages globally that are needed by nvim plugins
npm install -g typescript-language-server
npm install -g jjson
pnpm add -g --ignore-scripts @earendil-works/pi-coding-agent
{{- if eq .user_data.machine_type "work" }}
# @propelleraero/prp is on the private Propeller npm registry, which requires
# an auth token in ~/.npmrc. That token is populated by the npm-token-refresh
# LaunchAgent (once the user has signed into 1Password CLI). So prp is
# installed from that script instead of here, once auth is actually available.
{{- end }}
{{- else -}}
echo "[chezmoi] skipping {{ base .chezmoi.sourceFile }} — this is a Coder workspace"
{{- end }}
