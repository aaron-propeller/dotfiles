{{- if not .user_data.is_workspace -}}
{{- /*
Interactive: sign into 1Password app + enable CLI integration.

Runs after install-dependencies (which installs the 1password + 1password-cli
casks) and before load-npm-token-refresh (which needs `op` working). Skips
cleanly if already signed in or on a personal machine.

Sort order note: filename is install-interactive-1password so it sorts
alphabetically after install-dependencies (install-d..) and before
install-motion-sync (install-m..). See the sibling install-interactive-github-ssh
script for the SSH key equivalent.
*/}}
{{- if eq .user_data.machine_type "work" }}
#! /bin/zsh
set -e

# Fast path: if op is already signed in, don't waste the user's time.
if op whoami >/dev/null 2>&1; then
  echo "1Password CLI already signed in — skipping."
  exit 0
fi

if ! command -v op >/dev/null 2>&1; then
  echo "warning: 1Password CLI (op) is not installed. Skipping this step."
  exit 0
fi

cat <<'BANNER'

======================================================================
  ACTION REQUIRED: Sign in to 1Password and enable CLI integration
======================================================================

  1. The 1Password app is about to open (⌘-Space -> '1Password' if not).
  2. Sign in with your Propeller account.
  3. Open Settings (⌘,) -> Developer.
  4. Check 'Integrate with 1Password CLI'.
     macOS may prompt for Touch ID authorisation.
  5. Return to this terminal.

BANNER

open -a "1Password" 2>/dev/null || true

while true; do
  printf "  Press Enter when done (or type 'skip' to skip this step): "
  read -r ans </dev/tty
  if [[ "$ans" == "skip" ]]; then
    echo "  Skipped. The npm-token-refresh LaunchAgent will remain a no-op"
    echo "  until you sign in and enable CLI integration; @propelleraero/prp"
    echo "  won't be installed until then either."
    exit 0
  fi
  if op whoami >/dev/null 2>&1; then
    account=$(op whoami 2>/dev/null | awk -F': ' '/^Email:/ {print $2}')
    echo "  ✓ 1Password CLI signed in${account:+ ($account)}."
    break
  fi
  echo "  ✗ 'op whoami' still fails. Make sure the app is signed in and that"
  echo "    Settings -> Developer -> 'Integrate with 1Password CLI' is checked."
done
{{- end }}
{{- else -}}
echo "[chezmoi] skipping {{ base .chezmoi.sourceFile }} — this is a Coder workspace"
{{- end }}
