{{- /* Bootstrap config generated from this template by `chezmoi init`.

       Machine roles:
         - "workspace"   Coder cloud workspace (Linux, no GUI, no TTY at init)
         - "personal"    Personal physical Mac
         - "work"        Propeller work physical Mac

       is_workspace is auto-detected from CODER_WORKSPACE_ID (Coder sets this
       env var on every workspace agent). On any other machine, the usual
       personal/work prompt runs and is_workspace=false.

       Scripts gate on role, not OS, so a hypothetical Linux dev machine can
       still bootstrap in "personal" or "work" mode without hitting workspace
       shortcuts. */ -}}
{{- $is_workspace := ne (env "CODER_WORKSPACE_ID") "" -}}
{{- if $is_workspace -}}

[data.git_data]
    git_email = {{ env "CODER_WORKSPACE_OWNER_EMAIL" | default (env "GIT_AUTHOR_EMAIL") | default "coder@local" | quote }}
    git_name  = {{ env "CODER_WORKSPACE_OWNER_FULL_NAME" | default (env "GIT_AUTHOR_NAME") | default "Coder Workspace" | quote }}

[data.user_data]
    run_as_admin = false
    machine_type = "work"
    is_workspace = true
{{- else -}}
{{-   $git_email := promptString "Git email address" -}}
{{-   $git_name := promptString "Git name" -}}
{{-   $run_as_admin := promptBool "Run as admin?" -}}
{{-   $machine_type := promptChoice "Personal or work machine?" (list "personal" "work") -}}

[data.git_data]
    git_email = {{ $git_email | quote }}
    git_name = {{ $git_name | quote }}

[data.user_data]
    run_as_admin = {{ $run_as_admin }}
    machine_type = {{ $machine_type | quote }}
    is_workspace = false
{{- end }}
