{{- /* Bootstrap config generated from this template by `chezmoi init`.

       Machine profile is a single 3-way enum:

         - "workspace"   Coder cloud workspace (Linux, no GUI, no TTY at init)
         - "personal"    Personal physical machine
         - "work"        Propeller work physical machine (Mac today)

       workspace is auto-detected from CODER_WORKSPACE_ID. On anything else,
       chezmoi prompts personal vs work as before. Scripts gate on profile,
       not OS, so a hypothetical Linux dev laptop still bootstraps in
       "personal" or "work" mode without hitting workspace shortcuts. */ -}}
{{- $is_workspace := ne (env "CODER_WORKSPACE_ID") "" -}}
{{- if $is_workspace -}}

[data.git_data]
    git_email = {{ env "CODER_WORKSPACE_OWNER_EMAIL" | default (env "GIT_AUTHOR_EMAIL") | default "coder@local" | quote }}
    git_name  = {{ env "CODER_WORKSPACE_OWNER_FULL_NAME" | default (env "GIT_AUTHOR_NAME") | default "Coder Workspace" | quote }}

[data.user_data]
    run_as_admin = false
    profile      = "workspace"
{{- else -}}
{{-   $git_email := promptString "Git email address" -}}
{{-   $git_name := promptString "Git name" -}}
{{-   $run_as_admin := promptBool "Run as admin?" -}}
{{-   $profile := promptChoice "Machine profile?" (list "personal" "work") -}}

[data.git_data]
    git_email = {{ $git_email | quote }}
    git_name = {{ $git_name | quote }}

[data.user_data]
    run_as_admin = {{ $run_as_admin }}
    profile      = {{ $profile | quote }}
{{- end }}
